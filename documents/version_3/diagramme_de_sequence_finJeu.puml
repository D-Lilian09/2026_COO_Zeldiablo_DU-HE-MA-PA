@startuml
title etreFini() — le perso est sur la case de fin

participant ":MoteurGraphique" as moteur
participant ":JeuZeldiablo" as jeu
participant ":Personnage" as perso
participant ":Labyrinthe" as laby

moteur -> jeu : etreFini()
activate jeu

jeu -> perso : getPosition()
perso --> jeu : pos

jeu -> laby : etreCaseFin(x, y)
laby --> jeu : true

jeu --> moteur : true (jeu fini)
deactivate jeu
@enduml